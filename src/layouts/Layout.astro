---
// src/layouts/Layout.astro
import "../styles/global.css";
import Header from "../components/common/Header.astro";
import Footer from "../components/common/Footer.astro";
import Modal from "../components/common/Modal.astro";
import ProjectModal from "../components/ui/ProjectModal.astro";
import SEO from "../components/common/SEO.astro";
import FaviconManager from "../components/common/FaviconManager.astro";

interface Props {
  variant: "hub" | "design" | "solutions";
  seoTitle: string;
  seoDescription: string;
  seoImage: string;
  seoUrl: string;
  schemaType: "WebSite" | "Person";
}

const { variant, seoTitle, seoDescription, seoImage, seoUrl, schemaType } =
  Astro.props;
---

<html lang="es" data-route={variant} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <FaviconManager variant={variant} />
    <SEO
      title={seoTitle}
      description={seoDescription}
      image={seoImage}
      url={seoUrl}
      schemaType={schemaType}
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/Edward5126/E-core-icons@main/style.css"
    />
    <!-- Ranura para inyectar estilos específicos de la página desde el origen -->
    <slot name="head" />
  </head>

  <body
    class="bg-fondo text-texto-principal font-sans antialiased selection:bg-texto-resaltado/20 selection:text-texto-principal transition-colors duration-500 flex flex-col min-h-screen"
  >
    <Header activeRoute={variant} />

    <main class="flex-grow">
      <slot />
    </main>

    <div class="reveal-on-scroll">
      <Footer variant={variant} />
    </div>

    <Modal />
    <ProjectModal />

    <!-- Lógica centralizada para la revelación en el desplazamiento -->
    <script>
      const observerOptions = {
        root: null,
        rootMargin: "0px",
        threshold: 0.15,
      };

      const revealObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-revealed");
            observer.unobserve(entry.target);
          }
        });
      }, observerOptions);

      document.querySelectorAll(".reveal-on-scroll").forEach((el) => {
        revealObserver.observe(el);
      });
    </script>
  </body>
</html>
