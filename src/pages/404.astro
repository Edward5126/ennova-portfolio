---
// src/pages/404.astro
import Layout from "../layouts/Layout.astro";

const seoTitle = "Coordenada no encontrada | E-nnova";
const seoDescription =
  "La ruta solicitada no existe en el ecosistema. Vuelve al núcleo para explorar nuestras soluciones.";
const seoImage = "/IMG/og-hub.jpg";
const seoUrl = Astro.url.href;
---

<Layout
  variant="hub"
  seoTitle={seoTitle}
  seoDescription={seoDescription}
  seoImage={seoImage}
  seoUrl={seoUrl}
  schemaType="WebSite"
>
  <section
    class="relative w-full min-h-[85dvh] flex flex-col items-center justify-center px-6 overflow-hidden"
  >
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[300px] h-[300px] md:w-[450px] md:h-[450px] bg-texto-resaltado/5 rounded-full blur-[100px] mix-blend-screen pointer-events-none"
    >
    </div>

    <div
      class="relative z-10 flex flex-col items-center text-center max-w-2xl mx-auto"
    >
      <div class="relative flex justify-center items-center mb-6 w-full">
        <span
          class="text-[9rem] sm:text-[13rem] md:text-[15rem] font-black text-transparent bg-clip-text bg-gradient-to-b from-texto-principal/10 to-transparent select-none leading-none tracking-tighter"
        >
          404
        </span>
        <div
          class="absolute inset-0 flex items-center justify-center flex-col transform md:-translate-y-4"
        >
          <i
            class="icon-compass text-6xl md:text-8xl texto-degradado animate-pulse"
          ></i>
        </div>
      </div>

      <h1
        class="text-3xl md:text-4xl font-bold text-texto-principal mb-4 tracking-tight"
      >
        Página no encontrada
      </h1>

      <p
        class="text-base md:text-lg text-texto-secundario leading-relaxed mb-10 max-w-lg mx-auto"
      >
        La página a la que intentas acceder no está disponible. Es posible que
        el enlace sea incorrecto o que el contenido haya sido reubicado.
      </p>

      <a
        href="/"
        class="group flex items-center justify-center gap-3 px-8 py-4 bg-tarjetas backdrop-blur-md border border-contraste hover:border-texto-resaltado/40 text-texto-principal rounded-xl transition-all duration-300 shadow-neutral-sm active:scale-95 cursor-pointer"
      >
        <i
          class="icon-arrow-left text-lg text-texto-secundario fluido-base group-hover-fluido transition-transform group-hover:-translate-x-1"
        ></i>
        <span class="font-medium tracking-wide">Volver al inicio</span>
      </a>
    </div>
  </section>
</Layout>
