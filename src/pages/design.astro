---
// src/pages/design.astro
import Layout from "../layouts/Layout.astro";
import Hero from "../components/ui/Hero.astro";
import Portafolio from "../components/ui/Portafolio.astro";
import Servicios from "../components/ui/Servicios.astro";
import AcercaDe from "../components/ui/AcercaDe.astro";
import Testimonios from "../components/ui/Testimonios.astro";

const seoTitle = "E-nnova Design | Identidad Visual y Desarrollo Web";
const seoDescription =
  "Especialista en diseño de marca y desarrollo Front-End con Astro y Vanilla JavaScript. Construye una presencia digital de alto rendimiento desde el primer día.";
const seoImage = "/IMG/og-design.jpg";
const seoUrl = Astro.url.href;
---

<Layout
  variant="design"
  seoTitle={seoTitle}
  seoDescription={seoDescription}
  seoImage={seoImage}
  seoUrl={seoUrl}
  schemaType="Person"
>
  <Hero variant="design" />
  <div class="reveal-on-scroll"><Portafolio variant="design" /></div>
  <div class="reveal-on-scroll"><Servicios variant="design" /></div>
  <div class="reveal-on-scroll"><AcercaDe variant="design" /></div>
  <div class="reveal-on-scroll"><Testimonios variant="design" /></div>
</Layout>
