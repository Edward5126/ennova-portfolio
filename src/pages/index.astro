---
// src/pages/index.astro
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";

const seoTitle = "E-nnova | El núcleo de tus proyectos";
const seoDescription =
  "El punto de partida para creadores y emprendedores. Soluciones integrales de identidad visual, desarrollo web y automatización de procesos.";
const seoImage = "/IMG/og-hub.jpg";
const seoUrl = "https://tu-dominio.com/";

const logosConfianza = [
  {
    nombre: "Innova Dental",
    src: "/IMG/PROJECTS/ICONS/InnovaDentalLogo.svg",
    h: "h-8 md:h-10",
  },
  {
    nombre: "WitSet",
    src: "/IMG/PROJECTS/ICONS/WitSetLogo.svg",
    h: "h-7 md:h-9",
  },
  {
    nombre: "FI UADY",
    text: "FI UADY",
    h: "text-lg md:text-xl font-bold tracking-tight",
  },
  {
    nombre: "IEEE RAS",
    src: "/IMG/PROJECTS/ICONS/RASLogo.svg",
    h: "h-8 md:h-10",
  },
];
---

<Layout
  variant="hub"
  seoTitle={seoTitle}
  seoDescription={seoDescription}
  seoImage={seoImage}
  seoUrl={seoUrl}
  schemaType="WebSite"
>
  <style slot="head">
    .hypernova-container {
      position: absolute;
      top: 40%;
      left: 50%;
      transform: translate(-50%, -50%);
      pointer-events: none;
      z-index: 0;
    }

    .hypernova-ring {
      position: absolute;
      top: 50%;
      left: 50%;
      border: 1px solid rgba(250, 250, 250, 0.04);
      border-radius: 50%;
      transform: translate(-50%, -50%) scale(0.5);
      opacity: 0;
      animation: expand-ring 12s cubic-bezier(0.165, 0.84, 0.44, 1) infinite;
    }

    .ring-1 {
      width: 450px;
      height: 450px;
      animation-delay: 0s;
    }
    .ring-2 {
      width: 750px;
      height: 750px;
      animation-delay: 4s;
    }
    .ring-3 {
      width: 1050px;
      height: 1050px;
      animation-delay: 8s;
    }

    @keyframes expand-ring {
      0% {
        transform: translate(-50%, -50%) scale(0.4);
        opacity: 0;
        border-color: rgba(250, 250, 250, 0.1);
      }
      30% {
        opacity: 1;
      }
      100% {
        transform: translate(-50%, -50%) scale(1.4);
        opacity: 0;
        border-color: rgba(250, 250, 250, 0);
      }
    }

    /* Solución Anti-Flicker con dirección estrictamente vertical */
    .texto-instancia-design {
      background-image: linear-gradient(to top, #047857, #34d399);
      -webkit-background-clip: text;
      background-clip: text;
      transition: color 0.4s ease;
    }

    .texto-instancia-solutions {
      background-image: linear-gradient(to top, #3584a7, #4be2d0);
      -webkit-background-clip: text;
      background-clip: text;
      transition: color 0.4s ease;
    }

    .group:hover .revelar-degradado,
    .group\/item:hover .revelar-degradado-item {
      color: transparent !important;
    }
  </style>

  <section
    id="Inicio"
    class="relative min-h-[100dvh] flex flex-col justify-center items-center overflow-hidden border-b border-contraste/50"
  >
    <div class="hypernova-container w-full max-w-7xl h-full">
      <div class="hypernova-ring ring-3"></div>
      <div class="hypernova-ring ring-2"></div>
      <div class="hypernova-ring ring-1"></div>
    </div>

    <div
      class="relative z-10 w-full max-w-7xl mx-auto px-6 flex flex-col items-center text-center pt-24 pb-12"
    >
      <h1
        class="text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight mb-6 max-w-4xl text-texto-principal leading-[1.10]"
      >
        Todo gran proyecto<br class="hidden sm:block" /> nace de un núcleo.
      </h1>

      <p
        class="text-base md:text-lg text-texto-secundario leading-relaxed max-w-2xl mb-14"
      >
        Como una hipernova que expande su energía, impulsamos proyectos en sus
        fases iniciales. Selecciona la dimensión en la que deseas materializar
        tu visión.
      </p>

      <div
        class="flex flex-col md:flex-row items-stretch justify-center gap-6 w-full max-w-5xl"
      >
        <a
          href="/design"
          class="group flex-1 relative rounded-[24px] overflow-hidden bg-tarjetas backdrop-blur-xl border border-contraste hover:border-[#10b981]/50 shadow-neutral-md hover:shadow-neutral-lg p-8 md:p-10 flex flex-col justify-between text-left transition-all duration-500 block cursor-pointer"
        >
          <div class="flex justify-between items-start mb-12 relative z-20">
            <i
              class="icon-palette inline-block text-4xl text-texto-secundario texto-instancia-design revelar-degradado"
            ></i>
            <span
              class="px-3 py-1 bg-fondo border border-contraste group-hover:border-[#10b981]/40 text-texto-secundario text-xs font-mono rounded-full texto-instancia-design revelar-degradado transition-colors duration-400"
              >/design</span
            >
          </div>
          <div class="relative z-20">
            <h2
              class="text-3xl font-bold text-texto-principal mb-3 tracking-wide texto-instancia-design revelar-degradado"
            >
              Área Creativa
            </h2>
            <p class="text-sm text-texto-secundario leading-relaxed">
              Identidad visual sólida y desarrollo web Front-End. Tu marca
              digital de alto rendimiento.
            </p>
          </div>
        </a>

        <a
          href="/solutions"
          class="group flex-1 relative rounded-[24px] overflow-hidden bg-tarjetas backdrop-blur-xl border border-contraste hover:border-[#30d2be]/50 shadow-neutral-md hover:shadow-neutral-lg p-8 md:p-10 flex flex-col justify-between text-left transition-all duration-500 block cursor-pointer"
        >
          <div class="flex justify-between items-start mb-12 relative z-20">
            <i
              class="icon-microchip inline-block text-4xl text-texto-secundario texto-instancia-solutions revelar-degradado"
            ></i>
            <span
              class="px-3 py-1 bg-fondo border border-contraste group-hover:border-[#30d2be]/40 text-texto-secundario text-xs font-mono rounded-full texto-instancia-solutions revelar-degradado transition-colors duration-400"
              >/solutions</span
            >
          </div>
          <div class="relative z-20">
            <h2
              class="text-3xl font-bold text-texto-principal mb-3 tracking-wide texto-instancia-solutions revelar-degradado"
            >
              Área Técnica
            </h2>
            <p class="text-sm text-texto-secundario leading-relaxed">
              Ingeniería mecatrónica, control PLC y automatización. Hardware
              robusto para procesos físicos.
            </p>
          </div>
        </a>
      </div>

      <a
        href="#Ecosistema"
        class="mt-16 flex flex-col items-center opacity-60 hover:opacity-100 transition-opacity cursor-pointer group"
      >
        <span
          class="text-xs text-texto-secundario mb-2 font-medium tracking-wide"
          >O descubre cómo ambas dimensiones pueden colaborar</span
        >
        <i
          class="icon-arrow-down inline-block text-lg text-texto-principal transition-transform group-hover:translate-y-1"
        ></i>
      </a>
    </div>
  </section>

  <section class="w-full border-b border-contraste/50 bg-tarjetas/30 py-12">
    <div class="max-w-7xl mx-auto px-6 text-center">
      <p
        class="text-xs font-semibold text-texto-secundario/40 tracking-widest mb-8"
      >
        Confianza e Instituciones
      </p>
      <div
        class="flex flex-wrap justify-center items-center gap-10 md:gap-16 opacity-60 grayscale hover:grayscale-0 transition-all duration-700"
      >
        {
          logosConfianza.map((logo) =>
            logo.src ? (
              <Image
                src={logo.src}
                alt={logo.nombre}
                width={200}
                height={80}
                class={`${logo.h} w-auto`}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <span class={`${logo.h} text-texto-principal`}>{logo.text}</span>
            ),
          )
        }
      </div>
    </div>
  </section>

  <section id="Ecosistema" class="w-full max-w-7xl mx-auto px-6 py-24 md:py-32">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 auto-rows-min">
      <article
        class="md:col-span-3 bg-tarjetas/60 backdrop-blur-md border border-contraste rounded-[24px] overflow-hidden flex flex-col md:flex-row group hover:border-contraste/80 transition-colors relative"
      >
        <div class="w-full md:w-1/2 h-[300px] md:h-auto relative">
          <Image
            src="/IMG/IlustrativaContacto.jpg"
            alt="Eduardo Chan"
            width={800}
            height={800}
            class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700"
            loading="lazy"
            decoding="async"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-fondo/90 via-fondo/40 to-transparent"
          >
          </div>
        </div>

        <div
          class="w-full md:w-1/2 p-8 md:p-12 flex flex-col justify-center bg-gradient-to-t from-fondo via-fondo/80 to-transparent relative z-10 -mt-20 md:mt-0"
        >
          <div class="flex items-center gap-3 mb-4">
            <i
              class="icon-terminal inline-block text-2xl text-texto-principal transition-colors duration-500 group-hover:text-texto-resaltado/80"
            ></i>
            <span
              class="text-xs font-mono text-texto-secundario bg-tarjetas border border-contraste px-2 py-1 rounded-md"
              >perfil.json</span
            >
          </div>
          <h3 class="text-3xl md:text-5xl font-bold text-texto-principal mb-6">
            El Desarrollador
          </h3>
          <p
            class="text-texto-secundario leading-relaxed text-base md:text-lg mb-4"
          >
            Soy Eduardo Chan. Mi trayectoria en el desarrollo frontend nació de
            manera autodidacta gracias a un hobby, lo que me otorgó una visión
            creativa sin restricciones. Actualmente, soy estudiante de
            Ingeniería Mecatrónica, disciplina que aportó el rigor analítico y
            la capacidad de resolver problemas complejos.
          </p>
          <p
            class="text-texto-secundario leading-relaxed text-base md:text-lg mb-8"
          >
            E-nnova es la síntesis de ambos mundos: la libertad estética del
            diseño fusionada con la precisión absoluta de la ingeniería.
          </p>

          <div class="flex justify-start">
            <a
              href="/docs/CV_Eduardo_Chan.pdf"
              download
              class="group/btn flex items-center gap-3 px-8 py-4 bg-tarjetas hover:bg-tarjetas/80 border border-contraste text-texto-principal rounded-xl transition-all duration-300 shadow-sm font-semibold tracking-wide"
            >
              <span>Descargar documento vital</span>
              <i
                class="icon-download inline-block text-lg text-texto-secundario group-hover/btn:text-texto-principal transition-colors"
              ></i>
            </a>
          </div>
        </div>
      </article>

      <article
        class="md:col-span-2 bg-gradient-to-t from-fondo to-tarjetas border border-contraste rounded-[24px] p-8 md:p-10 flex flex-col justify-center group hover:border-contraste/80 transition-colors"
      >
        <span
          class="text-xs font-semibold text-texto-secundario tracking-wide block mb-4"
          >Sinergia de hardware y software</span
        >
        <h3 class="text-2xl md:text-3xl font-bold text-texto-principal mb-4">
          Conectando lo físico y lo digital
        </h3>
        <p class="text-texto-secundario leading-relaxed text-base max-w-xl">
          El verdadero potencial se desbloquea cuando una interfaz web intuitiva
          controla un sistema físico potente. Desarrollamos desde el hardware
          industrial hasta el panel de control en la nube que lo monitorea. Dos
          dimensiones, una sola solución fluida.
        </p>
      </article>

      <article
        class="bg-tarjetas/60 backdrop-blur-md border border-contraste rounded-[24px] p-8 md:p-10 flex flex-col justify-between group hover:border-contraste/80 transition-colors"
      >
        <div>
          <i
            class="icon-code inline-block text-2xl text-texto-principal transition-colors duration-500 group-hover:text-texto-resaltado/80 mb-6"
          ></i>
          <h3 class="text-xl font-bold text-texto-principal mb-4">
            Arquitectura limpia
          </h3>
          <p class="text-texto-secundario leading-relaxed text-sm">
            La calidad no es un lujo, es la estructura base. Un proyecto con
            visión de crecimiento requiere código desarrollado a la medida,
            libre de dependencias innecesarias y preparado estructuralmente para
            escalar a futuro.
          </p>
        </div>
      </article>
    </div>
  </section>

  <section
    id="Capacidades"
    class="w-full border-t border-contraste/50 bg-tarjetas/30 py-24 md:py-32"
  >
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16">
        <h2
          class="text-3xl md:text-4xl font-bold text-texto-principal tracking-tight mb-4"
        >
          Centro de capacidades
        </h2>
        <p class="text-texto-secundario text-lg">
          Tecnologías de alto rendimiento para cada especialidad.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div
          class="bg-fondo border border-contraste hover:border-[#10b981]/40 rounded-[16px] overflow-hidden group transition-colors duration-500"
        >
          <div
            class="bg-tarjetas px-4 py-2 border-b border-contraste group-hover:border-[#10b981]/40 flex items-center gap-2 transition-colors duration-500"
          >
            <div
              class="w-3 h-3 rounded-full bg-contraste group-hover:bg-[#10b981]/60 transition-colors duration-500"
            >
            </div>
            <div
              class="w-3 h-3 rounded-full bg-contraste group-hover:bg-[#10b981]/60 transition-colors duration-500 delay-75"
            >
            </div>
            <div
              class="w-3 h-3 rounded-full bg-contraste group-hover:bg-[#10b981]/60 transition-colors duration-500 delay-100"
            >
            </div>
            <span class="ml-2 text-xs font-mono text-texto-secundario"
              >herramientas-design.json</span
            >
          </div>
          <div class="p-6 md:p-8 font-mono text-sm text-texto-secundario">
            <ul class="space-y-4">
              <li class="flex items-center gap-4 group/item cursor-default">
                <i
                  class="icon-code inline-block text-texto-secundario texto-instancia-design revelar-degradado-item text-lg w-6 text-center"
                ></i>
                <span
                  class="text-texto-principal texto-instancia-design revelar-degradado-item"
                  >Astro Framework</span
                >
              </li>
              <li class="flex items-center gap-4 group/item cursor-default">
                <i
                  class="icon-file-code inline-block text-texto-secundario texto-instancia-design revelar-degradado-item text-lg w-6 text-center"
                ></i>
                <span
                  class="text-texto-principal texto-instancia-design revelar-degradado-item"
                  >Vanilla JavaScript</span
                >
              </li>
              <li class="flex items-center gap-4 group/item cursor-default">
                <i
                  class="icon-html5 inline-block text-texto-secundario texto-instancia-design revelar-degradado-item text-lg w-6 text-center"
                ></i>
                <span
                  class="text-texto-principal texto-instancia-design revelar-degradado-item"
                  >HTML5 & CSS3 Avanzado</span
                >
              </li>
              <li class="flex items-center gap-4 group/item cursor-default">
                <i
                  class="icon-pen-nib inline-block text-texto-secundario texto-instancia-design revelar-degradado-item text-lg w-6 text-center"
                ></i>
                <span
                  class="text-texto-principal texto-instancia-design revelar-degradado-item"
                  >Figma (UI/UX)</span
                >
              </li>
            </ul>
          </div>
        </div>

        <div
          class="bg-fondo border border-contraste hover:border-[#30d2be]/40 rounded-[16px] overflow-hidden group transition-colors duration-500"
        >
          <div
            class="bg-tarjetas px-4 py-2 border-b border-contraste group-hover:border-[#30d2be]/40 flex items-center gap-2 transition-colors duration-500"
          >
            <div
              class="w-3 h-3 rounded-full bg-contraste group-hover:bg-[#30d2be]/60 transition-colors duration-500"
            >
            </div>
            <div
              class="w-3 h-3 rounded-full bg-contraste group-hover:bg-[#30d2be]/60 transition-colors duration-500 delay-75"
            >
            </div>
            <div
              class="w-3 h-3 rounded-full bg-contraste group-hover:bg-[#30d2be]/60 transition-colors duration-500 delay-100"
            >
            </div>
            <span class="ml-2 text-xs font-mono text-texto-secundario"
              >herramientas-solutions.json</span
            >
          </div>
          <div class="p-6 md:p-8 font-mono text-sm text-texto-secundario">
            <ul class="space-y-4">
              <li class="flex items-center gap-4 group/item cursor-default">
                <i
                  class="icon-laptop-code inline-block text-texto-secundario texto-instancia-solutions revelar-degradado-item text-lg w-6 text-center"
                ></i>
                <span
                  class="text-texto-principal texto-instancia-solutions revelar-degradado-item"
                  >C++ / C# / Python</span
                >
              </li>
              <li class="flex items-center gap-4 group/item cursor-default">
                <i
                  class="icon-microchip inline-block text-texto-secundario texto-instancia-solutions revelar-degradado-item text-lg w-6 text-center"
                ></i>
                <span
                  class="text-texto-principal texto-instancia-solutions revelar-degradado-item"
                  >Siemens TIA Portal (SCL)</span
                >
              </li>
              <li class="flex items-center gap-4 group/item cursor-default">
                <i
                  class="icon-network-wired inline-block text-texto-secundario texto-instancia-solutions revelar-degradado-item text-lg w-6 text-center"
                ></i>
                <span
                  class="text-texto-principal texto-instancia-solutions revelar-degradado-item"
                  >Sistemas SCADA & IoT</span
                >
              </li>
              <li class="flex items-center gap-4 group/item cursor-default">
                <i
                  class="icon-cube inline-block text-texto-secundario texto-instancia-solutions revelar-degradado-item text-lg w-6 text-center"
                ></i>
                <span
                  class="text-texto-principal texto-instancia-solutions revelar-degradado-item"
                  >SolidWorks (Diseño CAD)</span
                >
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="w-full border-t border-contraste/50 py-24 md:py-32">
    <div class="max-w-7xl mx-auto px-6">
      <div class="mb-12">
        <h2
          class="text-3xl md:text-4xl font-bold text-texto-principal tracking-tight"
        >
          Proyectos fundacionales
        </h2>
        <p class="text-texto-secundario mt-3 text-lg">
          Casos de éxito de cada dimensión de servicio.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <a
          href="/design"
          class="group relative aspect-[4/3] md:aspect-[16/9] rounded-[24px] overflow-hidden border border-contraste hover:border-[#10b981]/50 bg-fondo block transition-colors duration-500"
        >
          <Image
            src="/IMG/PROJECTS/WitSet.jpg"
            alt="Proyecto WitSet"
            width={1280}
            height={720}
            class="w-full h-full object-cover opacity-40 group-hover:opacity-80 transition-opacity duration-700 grayscale group-hover:grayscale-0"
            loading="lazy"
            decoding="async"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-fondo via-fondo/60 to-transparent group-hover:from-fondo/90 transition-all duration-700"
          >
          </div>

          <div
            class="absolute bottom-0 left-0 w-full p-8 flex flex-col items-start z-10"
          >
            <span
              class="inline-flex items-center gap-2 px-3 py-1 bg-tarjetas/50 backdrop-blur-sm border border-contraste group-hover:border-[#10b981]/40 rounded-full mb-4 transition-colors duration-500"
            >
              <i
                class="icon-display text-texto-secundario texto-instancia-design revelar-degradado"
              ></i>
              <span
                class="text-texto-secundario texto-instancia-design revelar-degradado text-xs font-semibold"
                >Área Creativa</span
              >
            </span>
            <h3
              class="text-2xl font-bold text-texto-principal mb-2 texto-instancia-design revelar-degradado w-fit"
            >
              WitSet Hub
            </h3>
            <p
              class="text-sm text-texto-secundario mb-4 group-hover:text-texto-principal transition-colors duration-500"
            >
              Ecosistema modular de aplicaciones web progresivas centradas en la
              utilidad y educación.
            </p>
            <span
              class="text-xs font-mono text-texto-secundario texto-instancia-design revelar-degradado"
            >
              Explorar el portafolio ->
            </span>
          </div>
        </a>

        <a
          href="/solutions"
          class="group relative aspect-[4/3] md:aspect-[16/9] rounded-[24px] overflow-hidden border border-contraste hover:border-[#30d2be]/50 bg-fondo block transition-colors duration-500"
        >
          <Image
            src="/IMG/PROJECTS/RAS.jpg"
            alt="Sistema SCADA"
            width={1280}
            height={720}
            class="w-full h-full object-cover opacity-40 group-hover:opacity-80 transition-opacity duration-700 grayscale group-hover:grayscale-0"
            loading="lazy"
            decoding="async"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-fondo via-fondo/60 to-transparent group-hover:from-fondo/90 transition-all duration-700"
          >
          </div>

          <div
            class="absolute bottom-0 left-0 w-full p-8 flex flex-col items-start z-10"
          >
            <span
              class="inline-flex items-center gap-2 px-3 py-1 bg-tarjetas/50 backdrop-blur-sm border border-contraste group-hover:border-[#30d2be]/40 rounded-full mb-4 transition-colors duration-500"
            >
              <i
                class="icon-robot text-texto-secundario texto-instancia-solutions revelar-degradado"
              ></i>
              <span
                class="text-texto-secundario texto-instancia-solutions revelar-degradado text-xs font-semibold"
                >Área Técnica</span
              >
            </span>
            <h3
              class="text-2xl font-bold text-texto-principal mb-2 texto-instancia-solutions revelar-degradado w-fit"
            >
              Gestión Energética
            </h3>
            <p
              class="text-sm text-texto-secundario mb-4 group-hover:text-texto-principal transition-colors duration-500"
            >
              Sistema domótico industrial autónomo implementado para el
              monitoreo de consumo mediante HMI.
            </p>
            <span
              class="text-xs font-mono text-texto-secundario texto-instancia-solutions revelar-degradado"
            >
              Explorar los proyectos ->
            </span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section
