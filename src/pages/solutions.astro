---
import "../styles/global.css";
import Header from "../components/common/Header.astro";
import Footer from "../components/common/Footer.astro";
import Modal from "../components/common/Modal.astro";
import SEO from "../components/common/SEO.astro";
import FaviconManager from "../components/common/FaviconManager.astro";

import Hero from "../components/ui/Hero.astro";
import Portafolio from "../components/ui/Portafolio.astro";
import Servicios from "../components/ui/Servicios.astro";
import AcercaDe from "../components/ui/AcercaDe.astro";
import Testimonios from "../components/ui/Testimonios.astro";

const seoTitle = "E-nnova Solutions | Ingeniería y Automatización";
const seoDescription =
  "Servicios de ingeniería mecatrónica, control PLC, lógica SCL y sistemas SCADA. Optimización y automatización de procesos físicos.";
const seoImage = "/IMG/og-solutions.jpg";
const seoUrl = Astro.url.href;
---

<html lang="es" data-route="solutions" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <FaviconManager variant="solutions" />
    <SEO
      title={seoTitle}
      description={seoDescription}
      image={seoImage}
      url={seoUrl}
      schemaType="Person"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/Edward5126/E-core-icons@main/style.css"
    />
  </head>

  <body
    class="bg-fondo text-texto-principal font-sans antialiased selection:bg-texto-resaltado/20 selection:text-texto-principal transition-colors duration-500 flex flex-col min-h-screen"
  >
    <Header activeRoute="solutions" />

    <main class="flex-grow">
      <Hero variant="solutions" />

      <div class="reveal-on-scroll"><Portafolio variant="solutions" /></div>
      <div class="reveal-on-scroll"><Servicios variant="solutions" /></div>
      <div class="reveal-on-scroll"><AcercaDe variant="solutions" /></div>
      <div class="reveal-on-scroll"><Testimonios variant="solutions" /></div>
    </main>

    <div class="reveal-on-scroll"><Footer variant="solutions" /></div>
    <Modal />

    <script>
      const observerOptions = {
        root: null,
        rootMargin: "0px",
        threshold: 0.15,
      };
      const revealObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-revealed");
            observer.unobserve(entry.target);
          }
        });
      }, observerOptions);

      document.querySelectorAll(".reveal-on-scroll").forEach((el) => {
        revealObserver.observe(el);
      });
    </script>
  </body>
</html>
