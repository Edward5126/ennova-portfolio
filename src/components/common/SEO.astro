---
// src/components/common/SEO.astro

interface Props {
  title?: string;
  description?: string;
  image?: string;
  url?: string;
}

const {
  title = "Eduardo Chan | Diseño Web e Ingeniería Mecatrónica",
  description = "Portafolio dual de Eduardo Chan. Transformando ideas en soluciones efectivas: desde identidad de marca y desarrollo Front-End, hasta automatización industrial, lógica PLC y sistemas SCADA.",
  image = "/IMG/IlustrativaContacto.jpg", // Asegúrate de tener una imagen de previsualización general aquí
  url = "https://tudominio.com", // Reemplaza con tu dominio final
} = Astro.props;

// Construcción del Schema.org (JSON-LD) para definir tu dualidad profesional
const schemaPerson = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Eduardo Chan",
  image: new URL(image, Astro.url).toString(),
  jobTitle: [
    "Desarrollador Web Front-End",
    "Diseñador de Identidad de Marca",
    "Estudiante de Ingeniería Mecatrónica",
    "Desarrollador de Sistemas de Automatización",
  ],
  description: description,
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Universidad Autónoma de Yucatán",
    acronym: "UADY",
  },
  homeLocation: {
    "@type": "Place",
    name: "Mérida, Yucatán, México",
  },
  knowsAbout: [
    "Diseño Web",
    "UI/UX",
    "Astro",
    "Tailwind CSS",
    "Vanilla JavaScript",
    "Automatización Industrial",
    "Lógica SCL",
    "Controladores Lógicos Programables (PLC)",
    "Sistemas SCADA",
    "HMI",
  ],
  url: url,
  sameAs: [
    "https://github.com/Edward5126",
    "https://www.instagram.com/ennova_design/",
  ],
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />

<meta property="og:type" content="website" />
<meta property="og:url" content={url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={url} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image, Astro.url)} />

<script type="application/ld+json" set:html={JSON.stringify(schemaPerson)} />
