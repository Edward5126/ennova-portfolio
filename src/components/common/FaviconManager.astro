---
// src/components/common/FaviconManager.astro
interface Props {
  variant?: "hub" | "design" | "solutions";
}

const { variant = "hub" } = Astro.props;

const configuracionFavicon = {
  hub: "/IMG/logos/master/Logo.svg",
  design: "/IMG/logos/design/Logo.svg",
  solutions: "/IMG/logos/solutions/Logo.svg",
};

const faviconActual = configuracionFavicon[variant];
---

<link rel="icon" type="image/svg+xml" href={faviconActual} />
<link rel="apple-touch-icon" href="/IMG/maskable_icon_x192.png" />
<meta name="theme-color" content="#09090b" />
