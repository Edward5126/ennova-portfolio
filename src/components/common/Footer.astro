---
// src/components/common/Footer.astro

interface Props {
  variant?: "hub" | "design" | "solutions";
}

const { variant = "hub" } = Astro.props;

const currentPath = Astro.url.pathname;
const isHome = currentPath === "/" || currentPath === "/index.html";
const formatearEnlace = (hash: string) => (isHome ? hash : `/${hash}`);

const configuracionFooter = {
  hub: {
    marca: "E-nnova",
    descripcion:
      "El núcleo creativo y técnico para el desarrollo de proyectos integrales. Expandiendo ideas a través del diseño y la ingeniería.",
    logo: "/IMG/logos/master/Master%20-%20Logo%20Horizontal.svg",
    urlLogo: "/",
  },
  design: {
    marca: "E-nnova Design",
    descripcion:
      "Soluciones de identidad visual, diseño UI/UX y desarrollo web Front-End. Construyendo marcas digitales de alto rendimiento.",
    logo: "/IMG/logos/design/Colores%20-%20Logo%20Horizontal.svg",
    urlLogo: "/design",
  },
  solutions: {
    marca: "E-nnova Solutions",
    descripcion:
      "Ingeniería mecatrónica orientada a la automatización de procesos, sistemas SCADA y diseño electromecánico.",
    logo: "/IMG/logos/solutions/Colores%20-%20Logo%20Horizontal.svg",
    urlLogo: "/solutions",
  },
};

const datosActuales = configuracionFooter[variant];

const enlacesFooter =
  variant === "hub"
    ? [
        { url: "#Inicio", texto: "Inicio" },
        { url: "#Ecosistema", texto: "Ecosistema" },
        { url: "#Capacidades", texto: "Capacidades" },
        { url: "#FAQ", texto: "Preguntas frecuentes" },
      ]
    : [
        { url: "#Inicio", texto: "Inicio" },
        { url: "#Portafolio", texto: "Portafolio" },
        { url: "#Servicios", texto: "Servicios" },
        { url: "#AcercaDe", texto: "Acerca de" },
        { url: "#Testimonios", texto: "Testimonios" },
      ];

const redesSociales = [
  {
    url: "https://wa.me/529994247747",
    iconoClase: "icon-whatsapp-brands-solid-full",
    ariaLabel: "WhatsApp",
  },
  {
    url: "https://www.instagram.com/ennova_design/",
    iconoClase: "icon-instagram",
    ariaLabel: "Instagram",
  },
  {
    url: "https://www.linkedin.com/in/eduardo-chan/",
    iconoClase: "icon-linkedin",
    ariaLabel: "LinkedIn",
  },
  {
    url: "https://github.com/Edward5126",
    iconoClase: "icon-github",
    ariaLabel: "GitHub",
  },
  {
    url: "mailto:eduardochan_cach@hotmail.com",
    iconoClase: "icon-envelope",
    ariaLabel: "Correo Electrónico",
  },
  {
    url: "https://forms.gle/A5B7pvSFWFqWSEgV9",
    iconoClase: "icon-file",
    ariaLabel: "Formulario",
  },
  {
    url: "https://buymeacoffee.com/ennovadesign",
    iconoClase: "icon-paypal",
    ariaLabel: "Buy Me a Coffee",
  },
];

const anioActual = new Date().getFullYear();
---

<footer
  class="w-full bg-tarjetas backdrop-blur-md border-t border-contraste/80 pt-16 pb-8 px-6 mt-12"
>
  <div
    class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between gap-12 mb-12 items-center md:items-start text-center md:text-left"
  >
    <div
      class="w-full md:w-1/3 flex flex-col items-center md:items-start gap-6"
    >
      <a
        href={datosActuales.urlLogo}
        class="flex items-center cursor-pointer w-fit"
      >
        <img
          src={datosActuales.logo}
          alt={`${datosActuales.marca} Logo`}
          class="h-7 w-auto drop-shadow-sm transition-transform duration-300"
        />
      </a>
      <p class="text-texto-secundario text-sm leading-relaxed max-w-sm">
        {datosActuales.descripcion}
      </p>

      {
        !isHome && (
          <a
            href="/"
            class="group flex items-center gap-2 text-sm text-texto-secundario hover:text-transparent hover:bg-clip-text hover:bg-degradado-principal transition-all mt-2 font-medium tracking-wide"
          >
            <i class="icon-arrow-left" />
            <span>Volver a la página principal</span>
          </a>
        )
      }
    </div>

    <div class="w-full md:w-1/3 flex flex-col items-center">
      <div class="flex flex-col gap-4">
        <h4 class="text-texto-principal font-bold tracking-wide text-base mb-2">
          Explorar
        </h4>
        <ul class="flex flex-col gap-3">
          {
            enlacesFooter.map((enlace) => (
              <li>
                <a
                  href={formatearEnlace(enlace.url)}
                  class="text-texto-secundario hover:text-transparent hover:bg-clip-text hover:bg-degradado-principal transition-all text-sm font-medium tracking-wide"
                >
                  {enlace.texto}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="w-full md:w-1/3 flex flex-col items-center md:items-end">
      <div
        class="flex flex-col items-center md:items-start gap-4 w-full md:w-fit"
      >
        <h4 class="text-texto-principal font-bold tracking-wide text-base mb-2">
          Conectar
        </h4>
        <div
          class="flex flex-wrap justify-center md:justify-start gap-5 max-w-[220px]"
        >
          {
            redesSociales.map((red) => (
              <a
                href={red.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={red.ariaLabel}
                class="group transition-all duration-300 hover:-translate-y-1"
              >
                <i
                  class={`${red.iconoClase} inline-block text-2xl text-texto-secundario group-hover:text-transparent group-hover:bg-clip-text group-hover:bg-degradado-principal transition-all`}
                />
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <div
    class="max-w-7xl mx-auto pt-8 border-t border-contraste/50 flex flex-col md:flex-row items-center justify-between gap-4 text-center"
  >
    <span
      class="text-texto-secundario text-[11px] sm:text-xs font-medium tracking-wide"
    >
      © {anioActual}
      <span>{datosActuales.marca}</span>. Todos los derechos reservados.
    </span>
    <span
      class="text-texto-secundario text-[11px] sm:text-xs flex items-center justify-center gap-1.5"
    >
      Desarrollado con <i
        class="icon-heart inline-block text-transparent bg-clip-text bg-degradado-principal text-[10px]"
      ></i> por Eduardo Chan.
    </span>
  </div>
</footer>
