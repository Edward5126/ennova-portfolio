---
// src/components/ui/Portafolio.astro
import ProjectCard from "./ProjectCard.astro";
import type { Proyecto } from "../../types";
import proyectosData from "../../data/proyectos.json";

interface Props {
  variant: "design" | "solutions";
}

const { variant } = Astro.props;
const proyectosTodas: Proyecto[] = proyectosData as Proyecto[];

const proyectosFiltrados = proyectosTodas.filter((p) => p.contexto === variant);
const filtrosDisponibles =
  variant === "design"
    ? [
        "Todo",
        "Diseño Web",
        "Diseño Publicitario",
        "Identidad de Marca",
        "UI / UX",
      ]
    : [
        "Todo",
        "Automatización",
        "Domótica",
        "Sistemas SCADA",
        "Lógica SCL",
        "Diseño 3D",
      ];
---

<section
  id="Portafolio"
  class="w-full max-w-7xl mx-auto px-6 pt-32 pb-24 md:pt-40 md:pb-32"
>
  <div class="text-center mb-12 md:mb-16">
    <h2
      class="text-4xl md:text-5xl font-bold text-texto-principal mb-4 tracking-tight"
    >
      Mi <span class="texto-degradado transition-all duration-500"
        >Portafolio</span
      >
    </h2>
    <p class="text-texto-secundario max-w-2xl mx-auto text-lg">
      Explora una selección de proyectos donde he transformado ideas en
      soluciones digitales y tecnológicas efectivas.
    </p>
  </div>

  <div id="contenedor-filtros" class="relative mb-16 z-30">
    <div
      class="md:hidden flex justify-center w-full relative"
      id="dropdown-container"
    >
      <button
        id="btn-dropdown-filtro"
        class="w-full max-w-xs flex items-center justify-between gap-3 px-6 py-4 bg-tarjetas backdrop-blur-md border border-contraste hover:border-texto-resaltado/50 rounded-2xl shadow-neutral-sm transition-all duration-300 cursor-pointer group"
        aria-expanded="false"
      >
        <div class="flex items-center gap-3">
          <i
            class="icon-filter text-lg text-texto-secundario fluido-base group-hover-fluido"
          ></i>
          <span
            id="texto-filtro-actual"
            class="font-semibold text-texto-principal tracking-wide text-sm"
          >
            Categoría: Todo
          </span>
        </div>
        <i
          id="icono-flecha-dropdown"
          class="icon-chevron-down text-texto-secundario transition-transform duration-300"
        ></i>
      </button>

      <div
        id="menu-dropdown-filtro"
        class="absolute top-full left-1/2 -translate-x-1/2 w-full max-w-xs mt-3 bg-fondo/95 backdrop-blur-2xl border border-contraste/80 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.3)] overflow-hidden transition-all duration-300 origin-top transform scale-95 opacity-0 invisible"
      >
        <ul class="flex flex-col py-2 transition-opacity duration-300">
          {
            filtrosDisponibles.map((filtro, index) => (
              <li>
                <button
                  class={`btn-filtro btn-filtro-movil w-full text-left px-6 py-3 text-sm transition-colors duration-200 hover:bg-texto-resaltado/10 hover:text-texto-principal ${index === 0 ? "text-texto-resaltado bg-texto-resaltado/5 font-semibold" : "text-texto-secundario"}`}
                  data-filter={filtro}
                >
                  {filtro}
                </button>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="hidden md:block relative min-h-[44px]">
      <div
        class="flex flex-wrap justify-center gap-3 transition-all duration-500 absolute top-0 w-full"
      >
        {
          filtrosDisponibles.map((filtro, index) => (
            <button
              class={`btn-filtro btn-filtro-desktop px-6 py-2 rounded-full text-sm font-medium border transition-all duration-300 cursor-pointer shadow-sm hover:shadow-md ${index === 0 ? "border-texto-resaltado text-texto-resaltado bg-texto-resaltado/10" : "border-contraste text-texto-secundario hover:border-texto-resaltado/50 hover:text-texto-principal bg-tarjetas backdrop-blur-md"}`}
              data-filter={filtro}
            >
              {filtro}
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <div
    id="galeria-proyectos"
    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12 transition-all duration-500 transform"
  >
    {
      proyectosFiltrados.map((proyecto) => (
        <div class="proyecto-wrapper hidden">
          <ProjectCard proyecto={proyecto} />
        </div>
      ))
    }
  </div>

  <div id="contenedor-cargar-mas" class="mt-16 flex justify-center hidden">
    <button
      id="btn-cargar-mas"
      class="group flex items-center gap-3 px-8 py-3 bg-tarjetas backdrop-blur-md border border-contraste hover:border-texto-resaltado text-texto-secundario hover:text-texto-principal rounded-full cursor-pointer transition-all duration-300 shadow-neutral-sm font-medium tracking-wide"
    >
      <span>Ver más proyectos</span>
      <i
        class="icon-arrow-trend-down inline-block text-lg text-texto-secundario fluido-base group-hover-fluido"
      ></i>
    </button>
  </div>
</section>

<script>
  const btnDropdown = document.getElementById("btn-dropdown-filtro");
  const menuDropdown = document.getElementById("menu-dropdown-filtro");
  const iconoFlecha = document.getElementById("icono-flecha-dropdown");
  const textoFiltro = document.getElementById("texto-filtro-actual");
  const contenedorDropdown = document.getElementById("dropdown-container");

  const botonesFiltro = document.querySelectorAll(".btn-filtro");
  const contenedoresProyecto = document.querySelectorAll(".proyecto-wrapper");
  const btnCargarMas = document.getElementById("btn-cargar-mas");
  const contenedorCargarMas = document.getElementById("contenedor-cargar-mas");
  const contenedorGaleria = document.getElementById("galeria-proyectos");

  let dropdownAbierto = false;
  const ITEMS_POR_PAGINA = 6;
  let filtroActual = "Todo";
  let proyectosVisiblesCount = ITEMS_POR_PAGINA;
  let arrayProyectosFiltrados: Element[] = [];

  const toggleDropdown = () => {
    dropdownAbierto = !dropdownAbierto;
    if (dropdownAbierto) {
      menuDropdown?.classList.remove("opacity-0", "invisible", "scale-95");
      menuDropdown?.classList.add("opacity-100", "scale-100");
      iconoFlecha?.classList.add("rotate-180");
    } else {
      menuDropdown?.classList.remove("opacity-100", "scale-100");
      menuDropdown?.classList.add("opacity-0", "invisible", "scale-95");
      iconoFlecha?.classList.remove("rotate-180");
    }
  };

  if (btnDropdown) {
    btnDropdown.addEventListener("click", (e) => {
      e.stopPropagation();
      toggleDropdown();
    });
  }

  document.addEventListener("click", (e) => {
    if (
      dropdownAbierto &&
      contenedorDropdown &&
      !contenedorDropdown.contains(e.target as Node)
    ) {
      toggleDropdown();
    }
  });

  const actualizarGaleria = (conAnimacion = false) => {
    const ejecutarActualizacion = () => {
      arrayProyectosFiltrados = Array.from(contenedoresProyecto).filter(
        (wrapper) => {
          const tarjeta = wrapper.querySelector(".proyecto-card");
          const catData = tarjeta?.getAttribute("data-categorias") || "";
          const catArray = catData.split("|");
          return filtroActual === "Todo" || catArray.includes(filtroActual);
        },
      );

      contenedoresProyecto.forEach((w) => w.classList.add("hidden"));

      for (
        let i = 0;
        i < proyectosVisiblesCount && i < arrayProyectosFiltrados.length;
        i++
      ) {
        arrayProyectosFiltrados[i].classList.remove("hidden");
      }

      if (proyectosVisiblesCount < arrayProyectosFiltrados.length) {
        contenedorCargarMas?.classList.remove("hidden");
      } else {
        contenedorCargarMas?.classList.add("hidden");
      }
    };

    if (conAnimacion && contenedorGaleria) {
      contenedorGaleria.style.opacity = "0";
      contenedorGaleria.style.transform = "translateY(15px)";
      setTimeout(() => {
        ejecutarActualizacion();
        contenedorGaleria.style.opacity = "1";
        contenedorGaleria.style.transform = "translateY(0)";
      }, 300);
    } else {
      ejecutarActualizacion();
    }
  };

  const resetearBotonesFiltro = () => {
    botonesFiltro.forEach((btn) => {
      const isDesktop = btn.classList.contains("btn-filtro-desktop");
      const isActive = btn.getAttribute("data-filter") === filtroActual;

      if (isActive) {
        if (isDesktop) {
          btn.classList.add(
            "border-texto-resaltado",
            "text-texto-resaltado",
            "bg-texto-resaltado/10",
          );
          btn.classList.remove(
            "border-contraste",
            "text-texto-secundario",
            "bg-tarjetas",
            "backdrop-blur-md",
          );
        } else {
          btn.classList.add(
            "text-texto-resaltado",
            "bg-texto-resaltado/5",
            "font-semibold",
          );
          btn.classList.remove("text-texto-secundario");
        }
      } else {
        if (isDesktop) {
          btn.classList.remove(
            "border-texto-resaltado",
            "text-texto-resaltado",
            "bg-texto-resaltado/10",
          );
          btn.classList.add(
            "border-contraste",
            "text-texto-secundario",
            "bg-tarjetas",
            "backdrop-blur-md",
          );
        } else {
          btn.classList.remove(
            "text-texto-resaltado",
            "bg-texto-resaltado/5",
            "font-semibold",
          );
          btn.classList.add("text-texto-secundario");
        }
      }
    });

    if (textoFiltro) textoFiltro.textContent = `Categoría: ${filtroActual}`;
  };

  actualizarGaleria(false);

  if (btnCargarMas) {
    btnCargarMas.addEventListener("click", () => {
      proyectosVisiblesCount += ITEMS_POR_PAGINA;
      actualizarGaleria(false);
    });
  }

  botonesFiltro.forEach((boton) => {
    boton.addEventListener("click", (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const nuevoFiltro = target.getAttribute("data-filter") || "Todo";

      if (filtroActual === nuevoFiltro) {
        if (!target.classList.contains("btn-filtro-desktop")) toggleDropdown();
        return;
      }

      filtroActual = nuevoFiltro;
      resetearBotonesFiltro();

      if (!target.classList.contains("btn-filtro-desktop")) {
        toggleDropdown();
      }

      proyectosVisiblesCount = ITEMS_POR_PAGINA;
      actualizarGaleria(true);
    });
  });

  const tarjetasInteractivas = document.querySelectorAll(".proyecto-card");
  tarjetasInteractivas.forEach((tarjeta) => {
    tarjeta.addEventListener("click", (e) => {
      const target = e.currentTarget as HTMLElement;
      const datosCodificados = target.getAttribute("data-proyecto");
      const win = window as any;
      if (typeof win.abrirModalProyecto === "function" && datosCodificados) {
        win.abrirModalProyecto(datosCodificados);
      }
    });
  });
</script>
