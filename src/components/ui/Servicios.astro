---
// src/components/ui/Servicios.astro

interface Props {
  variant: "design" | "solutions";
}

const { variant } = Astro.props;

const serviciosDesign = [
  {
    titulo: "Diseño Web",
    descripcion:
      "Impulsa tu presencia online con sitios web atractivos, altamente funcionales y adaptables a cualquier dispositivo. Optimizados para el mejor rendimiento.",
    icono: "icon-display",
  },
  {
    titulo: "Diseño Publicitario",
    descripcion:
      "Capta la atención de tu audiencia con piezas gráficas impactantes, desde banners y flyers hasta contenido visual para redes sociales.",
    icono: "icon-palette",
  },
  {
    titulo: "Identidad de Marca",
    descripcion:
      "Construye una marca memorable con una identidad visual profesional que refleje tus valores: logotipo, paleta de colores y manuales de uso.",
    icono: "icon-fingerprint",
  },
  {
    titulo: "Diseño UI / UX",
    descripcion:
      "Mejora la experiencia de tus usuarios con interfaces intuitivas y atractivas. Soluciones pensadas para conectar de forma natural con quienes navegan.",
    icono: "icon-mobile-screen-button",
  },
  {
    titulo: "Identidad de Creador",
    descripcion:
      "Destaca como creador de contenido con una imagen visual única. Perfecto para streamers, influencers y proyectos digitales que buscan diferenciarse.",
    icono: "icon-sparkles",
  },
];

const serviciosSolutions = [
  {
    titulo: "Automatización Industrial",
    descripcion:
      "Diseño e implementación de sistemas de control automatizado para optimizar líneas de producción, reduciendo tiempos muertos y aumentando la eficiencia.",
    icono: "icon-robot",
  },
  {
    titulo: "Sistemas SCADA",
    descripcion:
      "Desarrollo de interfaces de supervisión y adquisición de datos en tiempo real (HMI/SCADA) para el monitoreo integral de procesos industriales.",
    icono: "icon-network-wired",
  },
  {
    titulo: "Lógica SCL & PLC",
    descripcion:
      "Programación estructurada y avanzada de Controladores Lógicos Programables (Siemens S7, etc.) utilizando arquitecturas modulares seguras.",
    icono: "icon-microchip",
  },
  {
    titulo: "Domótica & Energía",
    descripcion:
      "Soluciones de gestión autónoma para la optimización del consumo energético en instalaciones mediante redes de microcontroladores.",
    icono: "icon-bolt",
  },
  {
    titulo: "Diseño y Modelado CAD",
    descripcion:
      "Modelado 3D paramétrico, ensamblaje y análisis de esfuerzo para piezas mecánicas o chasis robóticos listos para manufactura o impresión 3D.",
    icono: "icon-compass-drafting",
  },
];

const serviciosActivos =
  variant === "design" ? serviciosDesign : serviciosSolutions;
---

<section
  id="Servicios"
  class="w-full max-w-7xl mx-auto px-6 pt-32 pb-24 md:pt-40 md:pb-32 border-t border-contraste/50"
>
  <div class="text-center mb-16 md:mb-24">
    <h2
      class="text-4xl md:text-5xl font-bold text-texto-principal mb-4 tracking-tight"
    >
      Mis <span class="texto-degradado transition-all duration-500"
        >Servicios</span
      >
    </h2>
    <p class="text-texto-secundario max-w-2xl mx-auto text-lg">
      Soluciones especializadas desarrolladas con precisión técnica y rigor
      estético para escalar tu proyecto.
    </p>
  </div>

  <div class="relative">
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 relative z-10 auto-rows-min"
    >
      {
        serviciosActivos.map((servicio) => (
          <article class="group relative bg-tarjetas backdrop-blur-md border border-contraste hover:border-texto-resaltado/40 rounded-[24px] p-8 md:p-10 transition-all duration-500 hover:shadow-neutral-lg overflow-hidden flex flex-col h-full text-left">
            <div class="absolute inset-0 bg-gradient-to-br from-texto-resaltado/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none" />

            <div class="mb-8 relative z-10">
              <i
                class={`${servicio.icono} inline-block text-4xl text-texto-secundario fluido-base group-hover-fluido duration-500`}
              />
            </div>

            <div class="relative z-10 flex-grow">
              <h3 class="text-xl font-bold text-texto-principal mb-4 tracking-wide fluido-base group-hover-fluido duration-500">
                {servicio.titulo}
              </h3>
              <p class="text-sm md:text-base text-texto-secundario leading-relaxed">
                {servicio.descripcion}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
