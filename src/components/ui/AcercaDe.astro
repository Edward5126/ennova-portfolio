---
// src/components/ui/AcercaDe.astro

interface Props {
  variant: "design" | "solutions";
}

const { variant } = Astro.props;

const configuracionAcerca =
  variant === "design"
    ? {
        titulo: "E-nnova Design",
        parrafos: [
          "¡Qué tal! Soy <strong class='text-texto-principal font-semibold'>Eduardo Chan</strong>, un apasionado del diseño gráfico y el desarrollo Front-End que convirtió una afición en una metodología de trabajo profesional.",
          "Creé E-nnova Design con el objetivo de ayudar a emprendedores a lanzar sus proyectos con una identidad visual sólida y plataformas web escalables desde su nacimiento.",
          "Mi enfoque combina estética moderna con rendimiento técnico, asegurando que cada marca no solo se vea bien, sino que funcione impecablemente.",
        ],
        lema: "¡Hagamos que tu proyecto nazca con estilo!",
      }
    : {
        titulo: "E-nnova Solutions",
        parrafos: [
          "¡Qué tal! Soy <strong class='text-texto-principal font-semibold'>Eduardo Chan</strong>, estudiante de Ingeniería Mecatrónica enfocado en la automatización y el desarrollo de sistemas industriales inteligentes.",
          "A través E-nnova Solutions, aplico rigor ingenieril para resolver problemas complejos de control, gestión energética e interfaces hombre-máquina (HMI/SCADA).",
          "Busco transformar procesos tradicionales en sistemas autónomos y eficientes mediante programación estructurada de PLC y microcontroladores distribuidos.",
        ],
        lema: "¡Impulsemos la eficiencia de tu sistema!",
      };
---

<section
  id="AcercaDe"
  class="w-full max-w-7xl mx-auto px-6 pt-32 pb-24 md:pt-40 md:pb-32 border-t border-contraste/50"
>
  <div class="flex flex-col md:flex-row items-stretch gap-10 md:gap-12">
    <div
      class="w-full md:w-5/12 relative group bg-tarjetas backdrop-blur-md border border-contraste rounded-[24px] p-2 flex items-center justify-center overflow-hidden transition-all duration-500 hover:border-texto-resaltado/30"
    >
      <div
        class="absolute inset-0 bg-gradient-to-tr from-texto-resaltado/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"
      >
      </div>
      <img
        src="/IMG/IlustrativaContacto.jpg"
        alt="Eduardo Chan"
        class="w-full h-full object-cover rounded-[20px] grayscale group-hover:grayscale-0 transition-all duration-700 aspect-square md:aspect-auto min-h-[300px]"
        loading="lazy"
        onerror="this.style.display='none';"
      />
    </div>

    <div
      class="w-full md:w-7/12 flex flex-col justify-between bg-tarjetas backdrop-blur-md border border-contraste hover:border-texto-resaltado/30 rounded-[24px] p-8 md:p-12 transition-all duration-500 group"
    >
      <div>
        <div class="flex items-center gap-3 mb-6">
          <i
            class="icon-terminal inline-block text-2xl text-transparent bg-clip-text bg-degradado-principal"
          ></i>
          <span
            class="text-xs font-semibold text-texto-secundario tracking-widest uppercase block"
            >Conoce mi trayectoria</span
          >
        </div>

        <h2
          class="text-3xl md:text-5xl font-bold text-texto-principal mb-8 tracking-tight"
        >
          Acerca de <span
            class="inline-block text-transparent bg-clip-text bg-degradado-principal transition-all duration-500"
            >{configuracionAcerca.titulo}</span
          >
        </h2>

        <div
          class="text-texto-secundario text-base md:text-lg leading-relaxed space-y-4 mb-10"
        >
          {
            configuracionAcerca.parrafos.map((parrafo) => (
              <p set:html={parrafo} />
            ))
          }
          <p class="font-medium text-texto-principal italic mt-6">
            {configuracionAcerca.lema}
          </p>
        </div>
      </div>

      <div class="flex justify-start">
        <a
          href="/docs/CV_Eduardo_Chan.pdf"
          download
          class="group/btn flex items-center gap-3 px-8 py-4 bg-transparent border border-contraste hover:border-texto-resaltado text-texto-principal transition-all duration-300 rounded-xl shadow-sm font-semibold tracking-wide"
        >
          <span>Descargar Currículum</span>
          <i
            class="icon-download inline-block text-lg text-texto-secundario group-hover/btn:text-transparent group-hover/btn:bg-clip-text group-hover/btn:bg-degradado-principal transition-all"
          ></i>
        </a>
      </div>
    </div>
  </div>
</section>
