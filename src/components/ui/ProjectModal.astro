---
// src/components/ui/ProjectModal.astro
---

<div
  id="project-modal"
  class="fixed inset-0 z-[9999] hidden items-center justify-center p-4 md:p-6 opacity-0 transition-all duration-500"
  role="dialog"
  aria-modal="true"
>
  <div
    id="project-modal-overlay"
    class="absolute inset-0 bg-fondo/95 backdrop-blur-2xl cursor-pointer"
  >
  </div>

  <div
    id="project-modal-content"
    class="relative w-full max-w-5xl bg-tarjetas border border-contraste rounded-[2rem] shadow-neutral-lg overflow-hidden transform scale-95 transition-all duration-500 ease-out flex flex-col max-h-[90vh]"
  >
    <button
      id="close-project-modal"
      class="absolute top-5 right-5 z-50 w-10 h-10 flex items-center justify-center bg-fondo/50 border border-contraste rounded-full hover:bg-contraste active:scale-90 transition-all cursor-pointer group backdrop-blur-md"
      aria-label="Cerrar detalles"
    >
      <i
        class="icon-close text-texto-secundario group-hover:text-transparent group-hover:bg-clip-text group-hover:bg-degradado-principal transition-all"
      ></i>
    </button>

    <div
      class="relative flex-shrink-0 w-full aspect-video md:aspect-[21/8] overflow-hidden bg-contraste/20"
    >
      <img
        id="project-modal-image"
        src=""
        alt=""
        class="w-full h-full object-cover"
      />
      <div
        class="absolute inset-0 bg-gradient-to-t from-tarjetas via-transparent to-transparent"
      >
      </div>
    </div>

    <div
      class="flex-1 overflow-y-auto custom-scrollbar p-8 md:p-12 lg:p-14"
      id="project-modal-scroll-area"
    >
      <div class="max-w-4xl mx-auto">
        <h2
          id="project-modal-title"
          class="text-3xl md:text-5xl font-bold text-texto-principal mb-8 tracking-tighter leading-tight"
        >
        </h2>

        <div class="space-y-12">
          <p
            id="project-modal-desc"
            class="text-texto-secundario text-base md:text-lg leading-relaxed"
          >
          </p>

          <div class="pt-8 border-t border-contraste">
            <h4
              class="text-sm font-bold text-texto-resaltado tracking-wide mb-4"
            >
              Estrategia y solución
            </h4>
            <p
              id="project-modal-challenge"
              class="text-texto-secundario text-sm md:text-base leading-relaxed"
            >
            </p>
          </div>

          <div class="pt-8 border-t border-contraste">
            <h4
              class="text-sm font-bold text-texto-principal tracking-wide mb-6"
            >
              Arquitectura técnica
            </h4>
            <div id="project-modal-tech" class="flex flex-wrap gap-6"></div>
          </div>
        </div>
      </div>
    </div>

    <div
      class="flex-shrink-0 p-6 md:px-12 bg-fondo/40 backdrop-blur-xl border-t border-contraste flex flex-col sm:flex-row items-center justify-between gap-6"
    >
      <div
        class="flex flex-wrap justify-center sm:justify-start gap-2"
        id="project-modal-tags"
      >
      </div>

      <div id="project-modal-link-container">
        <a
          id="project-modal-link"
          href=""
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center justify-center gap-3 px-10 py-3.5 bg-degradado-principal text-fondo font-bold rounded-xl hover:shadow-neutral-md transition-all active:scale-95 cursor-pointer text-sm"
        >
          <span>Explorar proyecto</span>
          <i
            class="icon-arrow-right group-hover:translate-x-1 transition-transform"
          ></i>
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  /* Barra de scroll personalizada acorde al diseño global */
  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
    margin: 20px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: var(--theme-contraste);
    border-radius: 10px;
    transition: background 0.3s ease;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: var(--theme-texto-resaltado);
  }

  /* Soporte para Firefox */
  .custom-scrollbar {
    scrollbar-width: thin;
    scrollbar-color: var(--theme-contraste) transparent;
  }
</style>

<script>
  const modal = document.getElementById("project-modal");
  const overlay = document.getElementById("project-modal-overlay");
  const content = document.getElementById("project-modal-content");
  const scrollArea = document.getElementById("project-modal-scroll-area");
  const closeBtn = document.getElementById("close-project-modal");

  const mImage = document.getElementById(
    "project-modal-image",
  ) as HTMLImageElement;
  const mTitle = document.getElementById("project-modal-title");
  const mDesc = document.getElementById("project-modal-desc");
  const mTags = document.getElementById("project-modal-tags");
  const mChallenge = document.getElementById("project-modal-challenge");
  const mTech = document.getElementById("project-modal-tech");
  const mLink = document.getElementById(
    "project-modal-link",
  ) as HTMLAnchorElement;
  const mLinkContainer = document.getElementById(
    "project-modal-link-container",
  );

  (window as any).abrirModalProyecto = (datosCodificados: string) => {
    if (!modal || !content) return;

    try {
      const p = JSON.parse(decodeURIComponent(atob(datosCodificados)));

      if (mImage) {
        mImage.src = p.imagenUrl;
        mImage.onerror = () => {
          mImage.src = p.imagenFallbackUrl;
        };
      }
      if (mTitle) mTitle.textContent = p.nombre;
      if (mDesc) mDesc.textContent = p.descripcion;
      if (mChallenge)
        mChallenge.textContent =
          p.desafioSolucion || "Detalles en proceso de documentación.";

      if (mTags) {
        mTags.innerHTML = p.categorias
          .map(
            (c: string) => `
          <span class="px-3 py-1 bg-texto-resaltado/5 text-texto-resaltado text-[11px] font-medium rounded-lg border border-texto-resaltado/20">
            ${c}
          </span>
        `,
          )
          .join("");
      }

      if (mTech) {
        mTech.innerHTML = p.tecnologias
          .map(
            (t: string) => `
          <div class="flex items-center gap-2.5 text-texto-secundario text-sm">
            <i class="icon-check text-texto-resaltado text-xs"></i>
            <span class="font-medium">${t}</span>
          </div>
        `,
          )
          .join("");
      }

      if (mLinkContainer) {
        if (p.urlProyecto) {
          mLinkContainer.classList.remove("hidden");
          mLink.href = p.urlProyecto;
        } else {
          mLinkContainer.classList.add("hidden");
        }
      }

      document.body.style.overflow = "hidden";
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      if (scrollArea) scrollArea.scrollTop = 0;

      setTimeout(() => {
        modal.classList.remove("opacity-0");
        content.classList.replace("scale-95", "scale-100");
      }, 10);
    } catch (e) {
      console.error("Error en despliegue de modal", e);
    }
  };

  const cerrarModal = () => {
    if (!modal || !content) return;
    document.body.style.overflow = "";
    modal.classList.add("opacity-0");
    content.classList.replace("scale-100", "scale-95");
    setTimeout(() => {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
    }, 500);
  };

  closeBtn?.addEventListener("click", cerrarModal);
  overlay?.addEventListener("click", cerrarModal);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !modal?.classList.contains("hidden"))
      cerrarModal();
  });
</script>
