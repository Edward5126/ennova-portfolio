---
// src/components/ui/ProjectModal.astro
---

<div
  id="modal-proyecto"
  class="fixed inset-0 z-[110] hidden items-center justify-center opacity-0 transition-opacity duration-400 p-4 sm:p-6"
  aria-modal="true"
  role="dialog"
>
  <div
    id="modal-proyecto-overlay"
    class="absolute inset-0 bg-[#000000a0] backdrop-blur-md cursor-pointer transition-opacity"
  >
  </div>

  <div
    class="relative w-full max-w-4xl bg-fondo/95 backdrop-blur-xl border border-contraste rounded-3xl shadow-neutral-lg overflow-hidden flex flex-col transform scale-95 transition-all duration-400 ease-out max-h-[90vh]"
    id="modal-proyecto-content"
  >
    <button
      id="btn-cerrar-modal-proyecto"
      class="absolute top-4 right-4 z-20 w-10 h-10 flex items-center justify-center bg-fondo/50 backdrop-blur-md border border-contraste rounded-full hover:bg-texto-resaltado/10 transition-all cursor-pointer shadow-neutral-sm group"
      aria-label="Cerrar detalles"
    >
      <i
        class="icon-close text-lg text-texto-secundario group-hover:text-transparent group-hover:bg-clip-text group-hover:bg-degradado-principal transition-all"
      ></i>
    </button>

    <div class="overflow-y-auto flex flex-col custom-scrollbar">
      <div class="w-full aspect-[21/9] md:aspect-[21/7] bg-contraste relative">
        <img
          id="pm-imagen"
          src=""
          alt="Portada del Proyecto"
          class="w-full h-full object-cover"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-fondo to-transparent"
        >
        </div>
      </div>

      <div class="p-6 md:p-10 -mt-10 relative z-10 flex flex-col gap-6">
        <div>
          <span
            id="pm-categorias"
            class="text-xs font-semibold text-texto-secundario tracking-widest mb-2 block"
          ></span>
          <h3
            id="pm-titulo"
            class="text-3xl md:text-4xl font-bold text-transparent bg-clip-text bg-degradado-principal tracking-tight w-fit"
          >
          </h3>
          <span id="pm-fecha" class="text-sm text-texto-secundario mt-1 block"
          ></span>
        </div>

        <div class="flex flex-col md:flex-row gap-10">
          <div class="flex-1 flex flex-col gap-6">
            <div>
              <h4
                class="text-sm font-bold text-texto-principal mb-2 tracking-wide uppercase"
              >
                Descripción
              </h4>
              <p
                id="pm-descripcion"
                class="text-texto-secundario text-sm leading-relaxed"
              >
              </p>
            </div>

            <div id="pm-contenedor-desafio" class="hidden">
              <h4
                class="text-sm font-bold text-texto-principal mb-2 tracking-wide uppercase"
              >
                Desafío & Solución
              </h4>
              <p
                id="pm-desafio"
                class="text-texto-secundario text-sm leading-relaxed"
              >
              </p>
            </div>
          </div>

          <div class="w-full md:w-64 flex flex-col gap-6">
            <div id="pm-contenedor-tech" class="hidden">
              <h4
                class="text-sm font-bold text-texto-principal mb-3 tracking-wide uppercase"
              >
                Herramientas
              </h4>
              <div id="pm-tech-list" class="flex flex-wrap gap-2"></div>
            </div>

            <div class="mt-auto pt-6 border-t border-contraste/50">
              <a
                id="pm-enlace"
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                class="hidden items-center justify-center gap-2 w-full px-6 py-3 border border-texto-resaltado text-texto-resaltado hover:bg-texto-resaltado/10 transition-all duration-300 rounded-lg cursor-pointer shadow-neutral-sm font-semibold tracking-wide"
              >
                <span>Visitar Proyecto</span>
                <i class="icon-arrow-up-right-from-square"></i>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Scrollbar personalizado para el interior del modal */
  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background-color: var(--theme-contraste);
    border-radius: 10px;
  }
</style>

<script>
  const modalProyecto = document.getElementById("modal-proyecto");
  const modalOverlay = document.getElementById("modal-proyecto-overlay");
  const btnCerrar = document.getElementById("btn-cerrar-modal-proyecto");
  const modalContent = document.getElementById("modal-proyecto-content");

  // Función global para abrir el modal y poblar los datos
  (window as any).abrirModalProyecto = (datosBase64: string) => {
    if (!modalProyecto || !modalContent) return;

    // Decodificar los datos del proyecto de forma segura
    const proyecto = JSON.parse(decodeURIComponent(atob(datosBase64)));

    // Poblar datos
    (document.getElementById("pm-imagen") as HTMLImageElement).src =
      proyecto.imagenUrl;
    (document.getElementById("pm-titulo") as HTMLElement).textContent =
      proyecto.nombre;
    (document.getElementById("pm-categorias") as HTMLElement).textContent =
      proyecto.categorias.join(" • ");
    (document.getElementById("pm-descripcion") as HTMLElement).textContent =
      proyecto.descripcion;

    const elemFecha = document.getElementById("pm-fecha");
    if (proyecto.fecha) {
      elemFecha!.textContent = proyecto.fecha;
      elemFecha!.style.display = "block";
    } else {
      elemFecha!.style.display = "none";
    }

    const contDesafio = document.getElementById("pm-contenedor-desafio");
    if (proyecto.desafioSolucion) {
      (document.getElementById("pm-desafio") as HTMLElement).textContent =
        proyecto.desafioSolucion;
      contDesafio!.classList.remove("hidden");
    } else {
      contDesafio!.classList.add("hidden");
    }

    const contTech = document.getElementById("pm-contenedor-tech");
    const listTech = document.getElementById("pm-tech-list");
    if (proyecto.tecnologias && proyecto.tecnologias.length > 0) {
      listTech!.innerHTML = proyecto.tecnologias
        .map(
          (tech: string) =>
            `<span class="px-3 py-1 bg-tarjetas border border-contraste rounded-full text-xs text-texto-secundario">${tech}</span>`,
        )
        .join("");
      contTech!.classList.remove("hidden");
    } else {
      contTech!.classList.add("hidden");
    }

    const elemEnlace = document.getElementById(
      "pm-enlace",
    ) as HTMLAnchorElement;
    if (proyecto.urlProyecto) {
      elemEnlace.href = proyecto.urlProyecto;
      elemEnlace.classList.remove("hidden");
      elemEnlace.classList.add("flex");
    } else {
      elemEnlace.classList.add("hidden");
      elemEnlace.classList.remove("flex");
    }

    // Animación de entrada
    document.body.style.overflow = "hidden";
    modalProyecto.classList.remove("hidden");
    modalProyecto.classList.add("flex");
    void modalProyecto.offsetWidth;
    modalProyecto.classList.remove("opacity-0");
    modalContent.classList.remove("scale-95");
    modalContent.classList.add("scale-100");
  };

  const cerrarModalProyecto = () => {
    if (!modalProyecto || !modalContent) return;
    document.body.style.overflow = "";
    modalProyecto.classList.add("opacity-0");
    modalContent.classList.remove("scale-100");
    modalContent.classList.add("scale-95");

    setTimeout(() => {
      modalProyecto.classList.add("hidden");
      modalProyecto.classList.remove("flex");
    }, 400);
  };

  if (btnCerrar && modalOverlay) {
    btnCerrar.addEventListener("click", cerrarModalProyecto);
    modalOverlay.addEventListener("click", cerrarModalProyecto);
  }
</script>
