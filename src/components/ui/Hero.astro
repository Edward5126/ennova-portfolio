---
// src/components/ui/Hero.astro
interface Props {
  variant: "design" | "solutions";
}

const { variant } = Astro.props;

const configuracionHero =
  variant === "design"
    ? {
        imagen: "/IMG/FondoHeroDesign.jpg",
        alt: "Entorno de diseño creativo",
        descripcion:
          "Comienza tu proyecto con una presencia digital valiosa desde su nacimiento y obtén una identidad que realmente destaque.",
        perfil: "Ingeniería y Automatización",
        enlacePerfil: "/solutions",
      }
    : {
        imagen: "/IMG/FondoHeroSolutions.jpg",
        alt: "Entorno de ingeniería y código",
        descripcion:
          "Trae a la vida tus proyectos bajo un enfoque ingenieril o agiliza tus procesos mediante la automatización.",
        perfil: "Diseño y Desarrollo Web",
        enlacePerfil: "/design",
      };
---

<section
  id="Inicio"
  class="relative w-full min-h-[100dvh] flex flex-col justify-center overflow-hidden pt-24 pb-12 md:py-0"
>
  <div class="absolute inset-0 z-0 bg-fondo">
    <img
      src={configuracionHero.imagen}
      alt={configuracionHero.alt}
      class="w-full h-full object-cover opacity-30 transition-opacity duration-700"
      loading="eager"
    />
    <div
      class="absolute inset-0 bg-gradient-to-r from-fondo via-fondo/90 to-transparent"
    >
    </div>
    <div
      class="absolute bottom-0 left-0 w-full h-32 md:h-48 bg-gradient-to-t from-fondo to-transparent"
    >
    </div>
    <div
      class="absolute top-1/4 right-1/4 w-[300px] h-[300px] md:w-[500px] md:h-[500px] bg-brand-a rounded-full opacity-5 blur-[80px] md:blur-[120px] mix-blend-screen pointer-events-none"
    >
    </div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 w-full">
    <div class="max-w-2xl w-full">
      <h1
        class="text-4xl sm:text-5xl md:text-7xl font-bold text-texto-principal tracking-tight mb-6 md:mb-8 leading-tight"
      >
        Inicia con <span
          class="text-transparent bg-clip-text bg-degradado-principal"
          >calidad</span
        >
      </h1>

      <div class="relative min-h-[120px] sm:min-h-[100px] mb-8 md:mb-12">
        <p
          class="text-base sm:text-lg md:text-xl text-texto-secundario leading-relaxed max-w-xl"
        >
          {configuracionHero.descripcion}
        </p>
      </div>

      <div
        class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4"
      >
        <button
          class="flex items-center justify-center gap-3 px-8 py-4 bg-degradado-principal text-fondo font-bold rounded-xl shadow-neutral-md hover:shadow-neutral-lg transition-all duration-300 cursor-pointer btn-interactivo w-full sm:w-auto"
        >
          <span>Cotizar proyecto</span>
          <i class="icon-paper-plane text-lg"></i>
        </button>

        <a
          href="#Portafolio"
          class="flex items-center justify-center gap-3 px-8 py-4 bg-transparent border border-contraste hover:border-texto-resaltado text-texto-principal rounded-xl transition-all duration-300 cursor-pointer group w-full sm:w-auto"
        >
          <span>Explorar portafolio</span>
          <i
            class="icon-arrow-right text-lg text-texto-secundario group-hover:text-transparent group-hover:bg-clip-text group-hover:bg-degradado-principal transition-all"
          ></i>
        </a>
      </div>
    </div>
  </div>

  <div
    class="mt-12 md:mt-0 md:absolute md:inset-0 z-20 pointer-events-none flex items-end justify-center md:justify-end max-w-7xl mx-auto px-6 w-full md:pb-12"
  >
    <a
      href={configuracionHero.enlacePerfil}
      class="group pointer-events-auto relative flex items-start gap-4 p-4 md:p-5 rounded-2xl bg-tarjetas/60 border border-contraste/50 hover:border-texto-resaltado/40 shadow-neutral-md hover:shadow-neutral-lg backdrop-blur-md w-full md:max-w-[380px] transition-all duration-500 overflow-hidden cursor-pointer"
    >
      <div class="mt-0.5 relative z-10 flex-shrink-0">
        <i
          class="icon-shuffle text-xl text-texto-secundario group-hover:text-transparent group-hover:bg-clip-text group-hover:bg-degradado-principal transition-all duration-500"
        ></i>
      </div>
      <p class="text-sm text-texto-secundario leading-relaxed relative z-10">
        ¿Buscas soluciones de <strong class="text-texto-principal tracking-wide"
          >{configuracionHero.perfil}</strong
        >? Explora la otra dimensión del estudio.
      </p>
    </a>
  </div>
</section>
